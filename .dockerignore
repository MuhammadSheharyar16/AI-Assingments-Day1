# Day 7 Task 12 — belt-and-braces alongside the Dockerfile's explicit,
# narrow COPY list: even if a future edit ever adds a careless `COPY . .`,
# none of this ever reaches the build context or an image layer.

# Never the developer's own local virtual environment — the image builds
# its own from uv.lock inside the builder stage.
.venv/
**/.venv/

# Version control, editors, OS cruft
.git/
.gitignore
.dockerignore
.idea/
.vscode/
*.DS_Store

# Secrets / local environment — never baked into an image
.env
.env.*

# Python build/cache artifacts
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Build outputs and generated evidence — not part of the shipped image;
# data/index and data/vectors are also gitignored for the same reason
# (reproducible build outputs, regenerated by `aico.retrieval.ingest`/`embed`)
data/index/
data/vectors/
artifacts/

# Test-only content — never needed at runtime
tests/

# Misc repo-only scripts
zip-python-project.ps1
zip-python-project.sh
