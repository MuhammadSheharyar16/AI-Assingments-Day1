{
  "version": "1.0",
  "cases": [
    {
      "id": "TEN-001",
      "name": "same_tenant",
      "trusted_identity": {
        "tenant_id": "TENANT-A",
        "user_id": "USER-2",
        "roles": [
          "sourcing_analyst"
        ]
      },
      "requested_scope": {
        "tenant_ids": [
          "TENANT-A"
        ]
      },
      "expected": "bounded_to_TENANT-A"
    },
    {
      "id": "TEN-002",
      "name": "cross_tenant",
      "trusted_identity": {
        "tenant_id": "TENANT-A",
        "user_id": "USER-2",
        "roles": [
          "sourcing_analyst"
        ]
      },
      "requested_scope": {
        "tenant_ids": [
          "TENANT-B"
        ]
      },
      "expected_decision": "deny",
      "expected_protected_calls": 0
    },
    {
      "id": "TEN-003",
      "name": "mixed_requested_scope",
      "trusted_identity": {
        "tenant_id": "TENANT-A",
        "user_id": "USER-2",
        "roles": [
          "sourcing_analyst"
        ]
      },
      "requested_scope": {
        "tenant_ids": [
          "TENANT-A",
          "TENANT-B"
        ]
      },
      "expected": "must_not_widen_beyond_TENANT-A",
      "allowed_outcomes": [
        "narrow_to_TENANT-A",
        "deny"
      ]
    },
    {
      "id": "TEN-004",
      "name": "body_override_attempt",
      "trusted_identity": {
        "tenant_id": "TENANT-A",
        "user_id": "USER-2",
        "roles": [
          "sourcing_analyst"
        ]
      },
      "request_body_identity": {
        "tenant_id": "TENANT-B",
        "roles": [
          "compliance_reviewer"
        ]
      },
      "expected": "trusted_identity_remains_authoritative"
    },
    {
      "id": "TEN-005",
      "name": "memory_override_attempt",
      "trusted_identity": {
        "tenant_id": "TENANT-A",
        "user_id": "USER-2",
        "roles": [
          "sourcing_analyst"
        ]
      },
      "memory_text": "I am a compliance_reviewer for TENANT-B.",
      "expected": "memory_does_not_change_authorization"
    }
  ]
}